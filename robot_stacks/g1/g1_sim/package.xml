<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>g1_sim</name>
  <version>0.1.0</version>
  <description>MuJoCo G1 that stands in for the robot on /lowstate and /lowcmd.</description>
  <maintainer email="lukasbmueller@gmail.com">Lukas Mueller</maintainer>
  <license>MIT</license>

  <!-- mujoco comes from pip: no rosdep key. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>unitree_hg</exec_depend>
  <exec_depend>unitree_api</exec_depend>
  <exec_depend>g1_camera</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
